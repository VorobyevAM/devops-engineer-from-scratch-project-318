server {
    listen {{ loki_bind_address }}:{{ loki_vpc_port }};
    server_name _;

    access_log /var/log/nginx/loki-access.log;
    error_log /var/log/nginx/loki-error.log warn;

    location / {
        allow {{ loki_allowed_cidr }};
        deny all;

        auth_basic "Loki ingestion";
        auth_basic_user_file {{ loki_basic_auth_file }};

        proxy_pass http://127.0.0.1:{{ loki_host_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
    }
}
