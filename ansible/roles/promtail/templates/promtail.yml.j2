server:
  http_listen_address: {{ promtail_http_listen_address }}
  http_listen_port: {{ promtail_http_port }}
  grpc_listen_port: 0

positions:
  filename: /var/lib/promtail/positions.yml

clients:
  - url: {{ promtail_loki_url }}
    basic_auth:
      username: {{ promtail_loki_user }}
      password: {{ monitoring_basic_auth_password | to_json }}

scrape_configs:
  - job_name: application-containers
    docker_sd_configs:
      - host: unix:///var/run/docker.sock
        refresh_interval: 5s
    relabel_configs:
      - source_labels: [__meta_docker_container_name]
        regex: /{{ promtail_app_container_name }}
        action: keep
      - source_labels: [__meta_docker_container_name]
        regex: /(.*)
        target_label: container
      - target_label: job
        replacement: application
      - target_label: env
        replacement: {{ promtail_environment }}
      - target_label: app
        replacement: {{ promtail_app_label }}
      - target_label: host
        replacement: {{ promtail_host_label }}
    pipeline_stages:
      - docker: {}
      - json:
          expressions:
            timestamp: '"@timestamp"'
            level: level
            logger: logger_name
            message: message
      - timestamp:
          source: timestamp
          format: RFC3339Nano
      - labels:
          level:

  - job_name: nginx-access
    static_configs:
      - targets: [localhost]
        labels:
          job: nginx
          env: {{ promtail_environment }}
          app: {{ promtail_app_label }}
          host: {{ promtail_host_label }}
          log_type: access
          __path__: /var/log/nginx/*access.json
    pipeline_stages:
      - json:
          expressions:
            timestamp: '"@timestamp"'
            method: request_method
            status: status
            request_time: request_time
            request_uri: request_uri
            remote_addr: remote_addr
      - timestamp:
          source: timestamp
          format: RFC3339
      - labels:
          method:
          status:

  - job_name: nginx-errors
    static_configs:
      - targets: [localhost]
        labels:
          job: nginx
          env: {{ promtail_environment }}
          app: {{ promtail_app_label }}
          host: {{ promtail_host_label }}
          log_type: error
          __path__: /var/log/nginx/observability-error.json
    pipeline_stages:
      - json:
          expressions:
            timestamp: '"@timestamp"'
            severity: severity
            message: message
      - timestamp:
          source: timestamp
          format: RFC3339
      - labels:
          severity:
