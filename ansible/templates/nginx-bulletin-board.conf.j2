server {
    listen 80 default_server;
    server_name {{ app_domain }};
    access_log {{ nginx_application_access_log }} observability_json;
    error_log syslog:server=unix:/dev/log,tag=nginx_observability warn;

    location ^~ /.well-known/acme-challenge/ {
        root {{ letsencrypt_webroot }};
        default_type text/plain;
    }

{% if nginx_tls_enabled %}
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    server_name {{ app_domain }};
    access_log {{ nginx_application_access_log }} observability_json;
    error_log syslog:server=unix:/dev/log,tag=nginx_observability warn;

    ssl_certificate {{ letsencrypt_live_dir }}/fullchain.pem;
    ssl_certificate_key {{ letsencrypt_live_dir }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000" always;
{% endif %}

    gzip on;
    gzip_types
        application/javascript
        application/json
        image/svg+xml
        text/css
        text/plain;

    location /assets/ {
        proxy_pass http://127.0.0.1:{{ app_host_port }};
        proxy_set_header Host 127.0.0.1;
        proxy_cache bulletin_board_static;
        proxy_cache_valid 200 1h;
        add_header Cache-Control "public, max-age=2592000, immutable" always;
    }

    location ~* ^/(favicon\.ico|manifest\.json|robots\.txt)$ {
        proxy_pass http://127.0.0.1:{{ app_host_port }};
        proxy_set_header Host 127.0.0.1;
        proxy_cache bulletin_board_static;
        proxy_cache_valid 200 1h;
        add_header Cache-Control "public, max-age=604800" always;
    }

    location ~* ^/api/files/(view|raw)$ {
        proxy_pass http://127.0.0.1:{{ app_host_port }};
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache bulletin_board_static;
        proxy_cache_valid 200 1h;
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        add_header Cache-Control "public, max-age=3600" always;
        add_header X-Cache-Status $upstream_cache_status always;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:{{ app_host_port }};
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-store" always;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ app_host_port }};
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        add_header Cache-Control "no-cache" always;
    }
}

server {
    listen 127.0.0.1:8081;
    server_name _;

    access_log off;

    location = /stub_status {
        stub_status;
        allow 127.0.0.1;
        deny all;
    }

    location / {
        return 404;
    }
}

server {
    listen {{ monitoring_bind_address }}:{{ monitoring_management_proxy_port }};
    server_name _;

    access_log {{ nginx_monitoring_access_log }} observability_json;
    error_log syslog:server=unix:/dev/log,tag=nginx_observability warn;

    auth_basic "{{ monitoring_basic_auth_realm }}";
    auth_basic_user_file {{ monitoring_basic_auth_file }};
    allow 127.0.0.1;
    allow {{ monitoring_server_cidr }};
    deny all;

    location = /actuator/prometheus {
        proxy_pass http://127.0.0.1:{{ app_management_host_port }};
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location = /stub_status {
        stub_status;
    }

    location = /nginx-exporter/metrics {
        proxy_pass http://{{ nginx_exporter_listen_address }}:{{ nginx_exporter_port }}/metrics;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ^~ /actuator/health {
        proxy_pass http://127.0.0.1:{{ app_management_host_port }};
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        return 404;
    }
}

server {
    listen {{ monitoring_bind_address }}:{{ monitoring_node_exporter_proxy_port }};
    server_name _;

    access_log {{ nginx_monitoring_access_log }} observability_json;
