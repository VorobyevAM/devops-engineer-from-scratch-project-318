    auth_basic_user_file {{ monitoring_basic_auth_file }};
    allow 127.0.0.1;
    allow {{ monitoring_server_cidr }};
    deny all;

    location = /metrics {
        proxy_pass http://{{ node_exporter_listen_address }}:{{ node_exporter_port }};
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1;
        proxy_set_header Authorization "";
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        return 404;
    }
}
